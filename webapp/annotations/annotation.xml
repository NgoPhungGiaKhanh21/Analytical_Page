<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════
  EDMX Annotation File – ZSB_PO_ANAL  (ZSD_PO_ANAL service)
  Mục đích: Bổ sung & ghi đè annotation cho ALP + Visual Filters
  
  ĐÃ XOÁ:  UI.PresentationVariant default (không qualifier)
